{
  "name": "tribody",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "トライアスリートのための痛みと解剖ガイド（動く3D筋肉図解つき）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "validate": "vitest run src/data",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "4.0"
  }
}
